# ============================================================================
# ADHD Learning Platform - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================================

# ============================================================================
# DEPLOYMENT MODE
# ============================================================================
# Options: local, azure
DEPLOYMENT_MODE=local

# ============================================================================
# SECURITY
# ============================================================================
# Generate a secure secret key: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================================================
# DATABASE (Leave empty for auto-configuration)
# ============================================================================
# Local SQLite (automatically configured in local mode)
LOCAL_DB_PATH=./data/adhd_learning.db

# Azure PostgreSQL (for production)
# AZURE_DB_SERVER=your-server.postgres.database.azure.com
# AZURE_DB_NAME=adhd_learning
# AZURE_DB_USER=your-username
# AZURE_DB_PASSWORD=your-password

# Or provide full DATABASE_URL directly
# DATABASE_URL=postgresql://user:pass@localhost/dbname

# ============================================================================
# STORAGE
# ============================================================================
# Local file storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=104857600

# Azure Blob Storage (for production)
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
# AZURE_STORAGE_CONTAINER=content

# ============================================================================
# AI SERVICES
# ============================================================================
# Anthropic Claude API
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Azure Speech Services (for production transcription)
# AZURE_SPEECH_KEY=your-azure-speech-key
# AZURE_SPEECH_REGION=eastus

# ============================================================================
# PROCESSING SETTINGS
# ============================================================================
# Chunk duration in seconds
CHUNK_MIN_DURATION=120
CHUNK_MAX_DURATION=300
SHORT_CONTENT_THRESHOLD=600

# ============================================================================
# CORS SETTINGS
# ============================================================================
# Add your frontend URLs (comma-separated)
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================================================
# WEBSOCKET SETTINGS
# ============================================================================
WS_HEARTBEAT_INTERVAL=30

# ============================================================================
# DEVELOPMENT
# ============================================================================
# Set to True for detailed SQL logging
# SQL_ECHO=False