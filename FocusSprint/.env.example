# FocusSprint Environment Variables
# Copy this file to .env and fill in your values

# ============ Backend API ============
# FastAPI backend URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ============ Database ============
# SQLite (local) or PostgreSQL (production)
DATABASE_URL=sqlite:///./focussprint.db
# For PostgreSQL: postgresql://user:password@localhost:5432/focussprint

# ============ Authentication ============
# JWT secret key (generate a strong random string)
SECRET_KEY=your-super-secret-key-change-in-production
# Token expiration in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ============ AI Services ============
# OpenAI API Key (for VLM and advanced features)
OPENAI_API_KEY=sk-your-openai-api-key

# Ollama URL for local LLM (optional, defaults to localhost)
OLLAMA_URL=http://localhost:11434

# VLM Model to use (gpt-4o-mini, gpt-4-vision-preview, etc.)
VLM_MODEL=gpt-4o-mini

# Enable VLM for visual content analysis
VLM_ENABLED=true

# ============ External Services ============
# Azure OpenAI (optional, for enterprise)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# ============ File Storage ============
# Max upload size in MB
MAX_UPLOAD_SIZE_MB=100

# Temporary file storage path
TEMP_STORAGE_PATH=./temp

# ============ Feature Flags ============
# Enable debug mode
DEBUG=false

# Enable CORS for all origins (disable in production)
CORS_ALLOW_ALL=true

# Rate limiting (requests per minute)
RATE_LIMIT_PER_MINUTE=60
